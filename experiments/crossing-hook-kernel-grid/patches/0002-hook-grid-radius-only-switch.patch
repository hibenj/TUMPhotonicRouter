+/// `PHOTONIC_ROUTER_CROSSING_HOOK_GRID`: which of the kernel grid's three
+/// search freedoms the crossing hook's dense grid takes. Unset or `paper`:
+/// none (the physical occupancy, as shipped). `radius`: the dynamic
+/// clearance expansion radius only. `radius-exempt`: the radius and its
+/// clearance-exempt cells. The port-open cells never (they are what broke
+/// `experiments/crossing-hook-kernel-grid/`). Experiment switch for the
+/// nine-cell gate and the 27-cell table (2026-11-09); read once per process.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum HookGridMode {
+    Paper,
+    Radius,
+    RadiusExempt,
+}
+
+pub(crate) fn hook_grid_mode() -> HookGridMode {
+    static MODE: std::sync::OnceLock<HookGridMode> = std::sync::OnceLock::new();
+    *MODE.get_or_init(
+        || match std::env::var("PHOTONIC_ROUTER_CROSSING_HOOK_GRID") {
+            Ok(value) if value == "radius" => HookGridMode::Radius,
+            Ok(value) if value == "radius-exempt" => HookGridMode::RadiusExempt,
+            _ => HookGridMode::Paper,
+        },
+    )
+}
